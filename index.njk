---
layout: base.njk
title: Alistair.com
---
<h3>Posts</h3>
<div class="post-feed">
  {% for post in collections.posts | reverse %}
    <article class="article-summary">
      <!-- Uses the postDate filter from your eleventy.config.mjs -->
      <span class="post-date">{{ post.date | postDate }}</span>
      
      <h2>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
      
      <!-- Optional: Add a brief summary if you have a 'description' in your frontmatter -->
      {% if post.data.description %}
        <p>{{ post.data.description }}</p>
      {% endif %}
    </article>
  {% endfor %}
</div>

<h3>Links</h3>
<div class="link-feed">
  {% for link in collections.links | reverse %}
    <article class="article-summary">
      <span class="post-date">{{ link.date | postDate }}</span>
      
      <h2>
        <a href="{{ link.data.externalUrl | default(link.url) }}" target="_blank" rel="noopener">
          {{ link.data.title }}
        </a>
      </h2>
      
      {% if link.data.description %}
        <p>{{ link.data.description }}</p>
      {% endif %}
    </article>
  {% endfor %}
</div>